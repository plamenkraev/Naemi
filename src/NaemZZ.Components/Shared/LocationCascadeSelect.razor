@using System.Extensions
@using System.Extensions.Collections.Generic

<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,140px),1fr))] gap-2 [&>*]:min-w-0 @Class">
    <Select Placeholder="@(ShowLabels ? "Област" : null)"
            Size="ThemeSize.Small"
            Items="@_regions"
            @bind-Value="@RegionId"
            ValueField="@(x => x.ID)"
            TextField="@(x => x?.NAME)"
            @bind-Value:after="OnRegionChangedAsync">
         <ChildContent>
            <AutoCompleteSearch SearchPlaceholder="Търси..." SearchFunc="(x, items) => Task.FromResult(items.WhereIIf(!x.IIsNullOrEmpty(), w => (w.NAME).Contains(x, StringComparison.OrdinalIgnoreCase)))" />
        </ChildContent>
    </Select>

    <Select Placeholder="@(ShowLabels ? "Община" : null)"
            Size="ThemeSize.Small"
            Items="@_municipalities"
            IsEnabled="@(RegionId is not null)"
            ValueField="@(x=> x.ID)"
            TextField="@(x => x?.NAME)"
            @bind-Value="@MunicipalityId"
            @bind-Value:after="OnMunicipalityChangedAsync">
        <ChildContent>
            <AutoCompleteSearch SearchPlaceholder="Търси..." SearchFunc="(x, items) => Task.FromResult(items.WhereIIf(!x.IIsNullOrEmpty(), w => (w.NAME).Contains(x, StringComparison.OrdinalIgnoreCase)))" />
        </ChildContent>
    </Select>

    <Select Placeholder="@(ShowLabels ? "Населено място" : null)"
            Size="ThemeSize.Small"
            Items="@_settlements"
            IsEnabled="@(MunicipalityId is not null)"
            TextField="@(x => x?.NAME)"
            ValueField="@(x => x.ID)"
            @bind-Value="@SettlementId"
            @bind-Value:after="OnSettlementChangedAsync">
          <ChildContent>
            <AutoCompleteSearch SearchPlaceholder="Търси..." SearchFunc="(x, items) => Task.FromResult(items.WhereIIf(!x.IIsNullOrEmpty(), w => (w.NAME).Contains(x, StringComparison.OrdinalIgnoreCase)))" />
        </ChildContent>
    </Select>
</div>
