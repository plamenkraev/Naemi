@page "/"
@using System.Extensions
@using System.Extensions.Collections.Generic
@using Blazicons
@using NaemZZ.Core.Dto
@using Tjt.Grid.Blazor
@using Tjt.Models
@inherits BaseDomComponent

<div class="flex h-full min-h-0">
    <aside class="flex w-72 shrink-0 flex-col border-r border-divider bg-content1">
        <Field class="p-2">
            <FieldLabel>Търсене по имена</FieldLabel>
            <FieldBody>
                <ThrottleInput ShowEndIcon="true" Placeholder="Търсене..." @bind-Value="SearchFilter.Value" />
            </FieldBody>
        </Field>
        <div class="min-h-0 flex-1 overflow-y-auto">
            @foreach (var landlord in _landlords)
            {
                <button @key="landlord" type="button"
                        id="landlord-@landlord.ID"
                        class="@Css.Class("block w-full border-b border-divider px-3 py-2 text-left text-sm hover:bg-surface-subtle", ("bg-warning/20", landlord.CompanyId is null), ("bg-primary/80 text-primary-foreground font-semibold", landlord.ID == _selectedLandlordId))"
                        @onclick="() => Select(landlord)">
                    <span class="flex items-center justify-between gap-2">
                        <span class="min-w-0 truncate">@(landlord.IsCompany ? landlord.LegalName : $"{landlord.NAME} {landlord.SURNAME} {landlord.LASTNAME}")</span>

                        <div class="flex items-center gap-1">
                            <Tooltip IsEnabled="@(landlord.CompanyId is null)" Text="Фирмата не е зададена">
                                @if (landlord.CompanyId is null)
                                {
                                    <SvgInlineIcon class="text-warning" Svg="@BootstrapIcon.ExclamationCircle" />
                                }
                            </Tooltip>
                            <span class="shrink-0 rounded-full bg-content2 px-2 py-0.5 text-xs" title="Брой имоти">@landlord.PropertyCount</span>
                        </div>

                    </span>
                </button>

            }
            @if (_landlords.Count == 0)
            {
                <div class="p-3 text-sm text-foreground-500">Няма резултати.</div>
            }
        </div>
    </aside>

    <div class="flex min-h-0 min-w-0 flex-1 flex-col gap-4 overflow-y-auto p-4" @onfocusout="@(() => RecordEdit())">
        <div class="flex flex-wrap items-center  gap-2">
            <h1 class="text-lg font-semibold">Договори за наем</h1>
            <div class="flex items-center gap-2 ml-10">
                <Button IconOnly
                        Tooltip="Добави наемодател"
                        Size="ThemeSize.Small"
                        Variant="Variant.Solid"
                        OnClick="@AddLandlord">
                    <SvgInlineIcon Svg="@BootstrapIcon.Plus" />
                </Button>
                <Button Tooltip="@L["Изтрий"]"
                        IconOnly
                        Size="ThemeSize.Small"
                        Color="PaletteColor.Error"
                        Variant="Variant.Solid"
                        OnClick="@DeleteCommand.InvokeAsync"
                        IsBusy="@(DeleteCommand.IsDisabled)"
                        IsEnabled="@(_current is not null)">
                    <SvgInlineIcon Svg="@BootstrapIcon.Trash" />
                </Button>
                <Button Tooltip="Запис"
                        IconOnly
                        Size="ThemeSize.Small"
                        Color="PaletteColor.Primary"
                        Variant="Variant.Solid"
                        OnClick="@SaveCommand.InvokeAsync"
                        IsBusy="@(SaveCommand.IsDisabled)" IsEnabled="@(_current is not null)">
                    <SvgInlineIcon Svg="@FluentUiIcon.Save" />

                </Button>
                <Button Tooltip="@L["Печат"]"
                        Size="ThemeSize.Small"
                        Variant="Variant.Solid"
                        IconOnly
                        OnClick="@PrintAsync"
                        IsEnabled="@(_current is not null)">
                    <SvgInlineIcon Svg="@BootstrapIcon.Printer" />
                </Button>

            </div>
            @if (HasUnsavedChanges)
            {
                <span class="text-xs text-warning">● Незапазени промени</span>
            }
            <div class="ml-auto">
                <Button Size="ThemeSize.Small" Variant="Variant.Flat" OnClick="@Undo" IsEnabled="@(_current is not null && (_editor.CanUndo || HasUnsavedChanges))">↶ Отмени</Button>
                <Button Size="ThemeSize.Small" Variant="Variant.Flat" OnClick="@Redo" IsEnabled="@_editor.CanRedo">↷ Повтори</Button>
                <Button Size="ThemeSize.Small" Variant="Variant.Flat" OnClick="@(() => _showHistory = !_showHistory)">История</Button>
            </div>

        </div>

        @if (_showHistory && _current is not null)
        {
            <div class="rounded-lg border border-divider p-2 text-sm">
                <strong>История на редакциите</strong>
                <div class="flex flex-wrap gap-1 mt-2">
                    @for (var i = 0; i < _editor.History.Count; i++)
                    {
                        var index = i;
                        <button type="button" class="@Css.Class("rounded border border-divider px-2 py-1", ("bg-primary/10 font-semibold", _editor.HistoryIndex == index))"
                                @onclick="() => JumpToHistory(index)">
                            @(_editor.History[i])
                        </button>
                    }
                </div>
            </div>
        }
        @if (_isLoadingLandlord)
        {
            <p class="text-sm text-foreground-500">Зареждане на данните...</p>
        }
        else if (_current is null)
        {
            <Alert Color="@PaletteColor.Info">Изберете наемодател или добавете нов.</Alert>
        }
        else
        {
            <ExpansionPanels>
                <ExpansionPanel DefaultIsExpanded Title="@($"Данни за наемодател {_current.GetFullName()}")">
                    <HeaderTemplate>
                        <div class="flex gap-4 items-center justify-between">
                            @($"Данни за наемодател {_current.GetFullName()}")

                            <Field Orientation="@Orientation.Horizontal" @onclick:stopPropagation>
                                <FieldLabel>
                                    @L["Цена на декар"] 
                                   
                                    <small class="ml-1 text-xxs text-current/60">
                                        @(_current.Price is null ? "(от фирмата)" : "(индивидуална)")
                                    </small>
                                   
                                </FieldLabel>
                                <FieldBody>
                                    <NumericEdit TValue="decimal?"
                                                 Placeholder="Цена на декар"
                                                 Size="ThemeSize.Small"
                                                 Step="1"                                                
                                                 Value="(_current.Price ?? _current.DefaultPrice)"
                                                 ValueChanged="@(x=> _current.Price = x)" >
                                            <FieldHelp>
                                           
                                        </FieldHelp>
                                    </NumericEdit>
                                </FieldBody>
                            </Field>
                        </div>
                        
                    </HeaderTemplate>
                    <ChildContent>
                        <section class="rounded-lg border border-current-border bg-surface text-surface-foreground p-3">

                            <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
                                <div class="flex flex-col gap-2">

                                    <Field>
                                        <FieldBody>
                                            <Select Placeholder="Фирма"
                                                    Size="ThemeSize.Small"
                                                    @bind-Value="_current.FIRM_ID"
                                                    Items="@_firms"
                                                    TValue="int?"
                                                    TItem="Company"
                                                    ValueField="@(x => x.Id)"
                                                    TextField="@(x => x.Name)"
                                                    @bind-Value:after="@(CompanyChanged)" />
                                        </FieldBody>
                                    </Field>

                                    <Field>
                                        <FieldBody>
                                            <Select Placeholder="Шаблон за договор (по подразбиране от фирмата)"
                                                    Size="ThemeSize.Small" @bind-Value="_current.ContractTemplateId"
                                                    Items="@_contractTemplates" ValueField="@(x => x.Id)" TextField="@(x => x.Name)" />
                                        </FieldBody>
                                    </Field>

                                    <SwitchGroup>
                                        <Switch Size="@ThemeSize.Small" @bind-Value="_current.IsCompany" />
                                        <SwitchLabel>Юридическо лице (фирма)</SwitchLabel>
                                    </SwitchGroup>

                                    @if (_current.IsCompany)
                                    {
                                        <TextField Placeholder="Наименование на фирмата" Size="ThemeSize.Small" @bind-Value="_current.CompanyName" ErrorMessage="@LandlordError("CompanyName")" />
                                        <TextField Placeholder="ЕИК / БУЛСТАТ" Size="ThemeSize.Small" @bind-Value="_current.EIK" ErrorMessage="@LandlordError("EIK")" />
                                        <TextField Placeholder="МОЛ / Представляващ" Size="ThemeSize.Small" @bind-Value="_current.MOL" />
                                    }
                                    else
                                    {
                                        <TextField Placeholder="Име" Size="ThemeSize.Small" @bind-Value="_current.NAME" ErrorMessage="@LandlordError("NAME")" />
                                        <TextField Placeholder="Презиме" Size="ThemeSize.Small" @bind-Value="_current.SURNAME" ErrorMessage="@LandlordError("SURNAME")" />
                                        <TextField Placeholder="Фамилия" Size="ThemeSize.Small" @bind-Value="_current.LASTNAME" ErrorMessage="@LandlordError("LASTNAME")" />
                                    }
                                </div>
                                <div class="flex flex-col gap-2">
                                    <TextField Placeholder="Улица" Size="ThemeSize.Small" @bind-Value="_current.STREET" ErrorMessage="@LandlordError("STREET")" />
                                    @if (!_current.IsCompany)
                                    {
                                        <TextField Placeholder="ЕГН" Size="ThemeSize.Small" @bind-Value="_current.EGN" ErrorMessage="@LandlordError("EGN")" />
                                        <div class="flex gap-2">
                                            <TextField Placeholder="ЛК №" Size="ThemeSize.Small" @bind-Value="_current.LK" ErrorMessage="@LandlordError("LK")" />
                                            <DateInput Placeholder="Дата" Size="ThemeSize.Small" DateFormat="dd.MM.yyyy" @bind-Value="_current.LKDATE" />
                                        </div>
                                        <TextField Placeholder="МВР" Size="ThemeSize.Small" @bind-Value="_current.MVR" ErrorMessage="@LandlordError("MVR")" />
                                    }

                                    <div class="flex gap-1 ">
                                        <TextField Placeholder="Телефон" Size="ThemeSize.Small" @bind-Value="_current.Phone" />

                                        <TextField Placeholder="Email" Size="ThemeSize.Small" @bind-Value="_current.Email" />
                                    </div>

                                    <LocationCascadeSelect @key="_current"
                                                           RegionId="@_current.OBLAST"
                                                           RegionIdChanged="@(v => _current.OBLAST = v)"
                                                           MunicipalityId="@_current.OBSTINA"
                                                           MunicipalityIdChanged="@(v => _current.OBSTINA = v)"
                                                           SettlementId="@_current.CITY"
                                                           SettlementIdChanged="@(v => _current.CITY = v)" />

                                </div>
                            </div>
                        </section>
                    </ChildContent>

                </ExpansionPanel>
            </ExpansionPanels>

            <section class="flex min-h-0 flex-col gap-2 rounded-lg border border-current-border bg-surface text-surface-foreground p-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <h2 class="font-semibold">Имоти (@_current.IMOTIs.Count)</h2>
                        <Button Size="ThemeSize.Small" Variant="Variant.Flat"
                                Color="@(_isPropertyEditMode ? PaletteColor.Error : PaletteColor.Default)"
                                OnClick="@TogglePropertyEditMode">
                            @(_isPropertyEditMode ? "Отажи промените" : "Редакция")
                        </Button>
                        @if (_isPropertyEditMode)
                        {
                            <Button Size="ThemeSize.Small" Variant="Variant.Flat" OnClick="@AddProperty">Добави</Button>
                        }
                    </div>
                    <span class="text-sm font-medium">Общо: @(_current.GetTotalArea.ToString("N3")) дка (@PriceFactory.New("EUR").Create(_current.GetTotalArea * (_current.Price ?? _current.DefaultPrice).GetValueOrDefault()))</span>
                </div>
                <div class="min-w-0 min-h-0 h-full">
                    <HtmlGrid TGridItem="PropertyDto"
                              FixedHeaderDataGridHeight="100%"
                              FixedHeader
                              Items="@_current.IMOTIs.AsQueryable()"
                              Hoverable="true"
                              Striped="true"
                              Class="w-full h-full mb-0">
                        <LoadingContent>

                        </LoadingContent>
                        <ChildContent>
                            <PropertyColumn Property="@(i => i.Id)" Title="ID" Sortable="true" />
                            <TemplateColumn Title="Област" Width="160">
                                @if (_isPropertyEditMode)
                                {
                                    <Select Size="ThemeSize.Small"
                                            Items="@_regions"
                                            ValueField="@(x => x.ID)"
                                            TextField="@(x => x?.NAME)"
                                            TValue="int?"
                                            TItem="Region"
                                            Value="@context.Item.EKATTE_AREA"
                                            ValueChanged="@(v => OnPropertyRegionChanged(context.Item, v))">
                                        <ChildContent>
                                            <AutoCompleteSearch SearchPlaceholder="Търси..." SearchFunc="(x, items) => Task.FromResult(items.WhereIIf(!x.IIsNullOrEmpty(), w => (w.NAME).Contains(x, StringComparison.OrdinalIgnoreCase)))" />
                                        </ChildContent>
                                    </Select>
                                }
                                else
                                {
                                    @RegionName(context.Item.EKATTE_AREA)
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Община" Width="160">
                                @if (_isPropertyEditMode)
                                {
                                    <Select Size="ThemeSize.Small"
                                            Items="@MunicipalitiesFor(context.Item)"
                                            IsEnabled="@(context.Item.EKATTE_AREA is not null)"
                                            ValueField="@(x => x.ID)"
                                            TextField="@(x => x?.NAME)"
                                            TValue="int?"
                                            TItem="Municipality"
                                            Value="@context.Item.EKATTE_MUNICIPALITY"
                                            ValueChanged="@(v => OnPropertyMunicipalityChanged(context.Item, v))">
                                        <ChildContent>
                                            <AutoCompleteSearch SearchPlaceholder="Търси..." SearchFunc="(x, items) => Task.FromResult(items.WhereIIf(!x.IIsNullOrEmpty(), w => (w.NAME).Contains(x, StringComparison.OrdinalIgnoreCase)))" />
                                        </ChildContent>
                                    </Select>
                                }
                                else
                                {
                                    @MunicipalityName(context.Item)
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Населено място" Width="160">
                                @if (_isPropertyEditMode)
                                {
                                    <Select Size="ThemeSize.Small"
                                            Items="@SettlementsFor(context.Item)"
                                            IsEnabled="@(context.Item.EKATTE_MUNICIPALITY is not null)"
                                            ValueField="@(x => x.ID)"
                                            TextField="@(x => x?.NAME)"
                                            TValue="int?"
                                            TItem="Settlement"
                                            Value="@context.Item.EKATTE_CITY"
                                            ValueChanged="@(v => OnPropertySettlementChanged(context.Item, v))">
                                        <ChildContent>
                                            <AutoCompleteSearch SearchPlaceholder="Търси..." SearchFunc="(x, items) => Task.FromResult(items.WhereIIf(!x.IIsNullOrEmpty(), w => (w.NAME).Contains(x, StringComparison.OrdinalIgnoreCase)))" />
                                        </ChildContent>
                                    </Select>
                                }
                                else
                                {
                                    @SettlementName(context.Item)
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Местност">
                                @if (
                                    _isPropertyEditMode)
                                {
                                    <TextField Size="ThemeSize.Small" @bind-Value="context.Item.TERRAIN" />
                                }
                                else
                                {
                                    @context.Item.TERRAIN
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Граници">
                                @if (_isPropertyEditMode)
                                {
                                    <TextField Size="ThemeSize.Small" @bind-Value="context.Item.LIMITS" />
                                }
                                else
                                {
                                    @context.Item.LIMITS
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Номер" SortBy="@(GridSort<PropertyDto>.ByAscending(x => x.NOMER))" Width="120">
                                @if (_isPropertyEditMode)
                                {
                                    <TextField Size="ThemeSize.Small"
                                               @bind-Value="context.Item.NOMER"
                                               ErrorMessage="@PropertyError(context.Item, "NOMER")" />
                                }
                                else
                                {
                                    @context.Item.NOMER
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="К" Width="100">
                                @if (_isPropertyEditMode)
                                {
                                    <Select Size="ThemeSize.Small"
                                            Items="@_categories"
                                            ValueField="@(x => x.ID)"
                                            TextField="@(x => x?.NAME)"
                                            @bind-Value="context.Item.CATEGORY">
                                    </Select>
                                }
                                else
                                {
                                    @CategoryName(context.Item.CATEGORY)
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Декари" SortBy="@(GridSort<PropertyDto>.ByAscending(x => x.PLOST))" Width="120">
                                @if (_isPropertyEditMode)
                                {
                                    <NumericEdit TValue="decimal?" Size="ThemeSize.Small" Step="0.001m"
                                                 @bind-Value="context.Item.PLOST"
                                                 ErrorMessage="@PropertyError(context.Item, "PLOST")" />
                                }
                                else
                                {
                                    @context.Item.PLOST?.ToString("N3")
                                }
                            </TemplateColumn>
                            @if (_isPropertyEditMode)
                            {
                                <TemplateColumn Title="Действия">
                                    <div class="flex gap-1">
                                        <Button Tooltip="Копирай" IconOnly="true" Size="ThemeSize.Small" Variant="Variant.Light"
                                                OnClick="@(() => CopyProperty(context.Item))">
                                            <SvgInlineIcon Svg="@FluentUiIcon.Copy"></SvgInlineIcon>
                                        </Button>
                                        <Button Tooltip="Постави" IconOnly="true" Size="ThemeSize.Small" Variant="Variant.Light"
                                                OnClick="@(() => PasteProperty(context.Item))"
                                                IsEnabled="@(_propertyClipboard is not null)">
                                            <SvgInlineIcon Svg="@FluentUiIcon.ClipboardPaste"></SvgInlineIcon>
                                        </Button>
                                        <Button Tooltip="Изтрий" Size="ThemeSize.Small" IconOnly="true" Color="PaletteColor.Error" Variant="Variant.Light"
                                                OnClick="@(() => DeleteProperty(context.Item))">
                                            <SvgInlineIcon Svg="@FluentUiIcon.Delete"></SvgInlineIcon>
                                        </Button>
                                    </div>
                                </TemplateColumn>
                            }
                        </ChildContent>

                    </HtmlGrid>
                </div>
            </section>
        }
    </div>
</div>