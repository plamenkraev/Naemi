@using System.Extensions.Collections.Generic
@using NaemZZ.Components.Events
@using Tjt.AspNetCore.WebAssembly.Theming.Navigation
@inherits Tjt.AspNetCore.Components.BaseLayoutComponent

<div class="flex h-screen w-screen flex-col overflow-hidden bg-background text-foreground">
    <header class="flex shrink-0 items-center justify-between gap-3 border-b border-divider bg-appbar-background text-appbar-foreground px-4 py-2">
       
        <a href="/" class="text-lg font-semibold">
            Договори за наем

            <HeaderInfo/>
        </a>

        <nav class="flex items-center gap-4 text-sm" aria-label="Основно меню">

            @foreach (var menuItem in MainMenu?.Items.Where(w => !w.IsHidden) ?? [])
            {
                @if (menuItem.IsLeaf)
                {
                    <HtmlLink @key="@menuItem"
                              Href="@(menuItem.Url)"
                              role="menuitem"
                              ActiveClass="active bg-appbar-foreground/20"
                              Class="cursor-pointer select-none p-1 rounded"
                              tabindex="-1">
                        <span class="inline">@menuItem.DisplayName</span>

                    </HtmlLink>
                }
                else
                {
                    <Dropdown @key="@menuItem" Class="mt-2 flex min-w-48">
                        <DropdownTrigger Context="opened">
                            <HtmlLink Href="@menuItem.Url"
                                      @onclick:preventDefault
                                      Match="@NavLinkMatch.Prefix"
                                      ActiveClass="bg-appbar-foreground/20"
                                      Class="cursor-pointer select-none p-1 rounded">@menuItem.DisplayName</HtmlLink>
                        </DropdownTrigger>
                        <DropdownMenu>

                            @foreach (var menuItem in menuItem.Items.SelectRecursive(x => x.Items).Where(w => !w.IsHidden) ?? [])
                            {
                                <DropdownItem @key="menuItem.ElementId" role="presentation"
                                              Class="block has-[.active]:bg-current/5">
                                    <HtmlLink Class="rounded w-full"
                                              Href="@(menuItem.Url)"
                                              role="menuitem"
                                              ActiveClass="active "
                                              tabindex="-1">
                                        <span class="inline">@menuItem.DisplayName</span>

                                        @if (menuItem.Component.Value != null)
                                        {
                                            if (menuItem.Component.IsT0)
                                            {
                                                @menuItem.Component.AsT0
                                            }
                                            else
                                            {
                                                <DynamicComponent Type="@menuItem.Component.AsT1" Parameters="@menuItem.CustomData" />
                                            }
                                        }
                                    </HtmlLink>
                                </DropdownItem>
                            }

                        </DropdownMenu>
                    </Dropdown>
                }
            }

            <SwitchThemeMode />

        </nav>
    </header>
    <main class="flex min-h-0 flex-1 flex-col overflow-hidden">@Body</main>
</div>

@code {
    [Inject] IMenuManager MenuManager { get; set; } = null!;
    private ApplicationMenu? MainMenu { get; set; }

    protected override async Task OnInitializedAsync()
    {
        MainMenu = await MenuManager.GetMainMenuAsync(TokenSource.Token);

        await base.OnInitializedAsync();
    }

}