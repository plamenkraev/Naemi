<Window x:Class="NaemZZ.Desktop.Printing.PrintContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Печат на договор" Height="700" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblPage" Grid.Row="0" HorizontalAlignment="Right" FontWeight="Bold" />

        <RichTextBox x:Name="RTB" Grid.Row="1" Margin="0 5" FontFamily="Book Antiqua"
                     TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Aliased"
                     AcceptsTab="True" AcceptsReturn="True" VerticalScrollBarVisibility="Visible"
                     TextChanged="OnTextChanged">
            <RichTextBox.Resources>
                <Style x:Key="{x:Type Paragraph}" TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0" />
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="2">
            <Button x:Name="PrintButton" Content="Принт" Width="80" Margin="4" Click="PrintButton_Click" />
            <Button x:Name="CancelButton" Content="Затвори" Width="80" Margin="4" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
