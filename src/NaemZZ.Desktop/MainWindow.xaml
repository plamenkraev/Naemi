<Window x:Class="NaemZZ.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:NaemZZ.Components;assembly=NaemZZ.Components"
        Title="Договори за наем" Height="800" Width="1100" WindowStartupLocation="CenterScreen"
        MinWidth="1100" MinHeight="800"
        Icon="Assets/brovis.ico">
    <Grid>
        <blazor:BlazorWebView x:Name="BlazorView" HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:App}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
